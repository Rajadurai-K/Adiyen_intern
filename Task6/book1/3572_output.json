[
  {
    "verse": "यमयुक्तवर्णपिण्डो निबिडो अयः",
    "ref": "पिण्डलक्षणम् -> 1"
  },
  {
    "verse": "पिण्डवद्भवति यथा रुक्क्म शग्ग्मान्तः",
    "ref": "पिण्डलक्षणम् -> 2"
  },
  {
    "verse": "अघ्घ्नियाः तनमिच्च्मियच्छ्मश्रुणः परिज्ज्मा आट्ट्णारः\nआत्मनः दध्ना पाप्प्मा दभ्भ्नो",
    "ref": "पिण्डलक्षणम् -> 3"
  },
  {
    "verse": "इत्यादिस्पर्शान्तस्था योगोविश्लथबन्धस्तु दारुपिण्डसमः",
    "ref": "पिण्डलक्षणम् -> 4"
  },
  {
    "verse": "पा कथाचिद्वसवःस्संवत्सरमुख्थं वज्रः इत्यादिः",
    "ref": "पिण्डलक्षणम् -> 5"
  },
  {
    "verse": "प अयमोष्मोत्तमयोगश्लथबन्धस्तूलपिण्डसमः",
    "ref": "पिण्डलक्षणम् -> 6"
  },
  {
    "verse": "श्लथबन्धो यत्र नणौ वकारपूर्वौ भवेत्तत्र",
    "ref": "पिण्डलक्षणम् -> 7"
  },
  {
    "verse": "अयमः यमवर्णशून्यः यमूष्मोत्तमानां क्रमान्मिथोऽन्वयः",
    "ref": "पिण्डलक्षणम् -> 8"
  },
  {
    "verse": "सकूलपिण्ड अयमः बविशेषणमयः पिण्डाद्भेदज्ञापनाय यथा",
    "ref": "पिण्डलक्षणम् -> 9"
  },
  {
    "verse": "ब्रह्मवादिनः अह्नां अपराह्णे श्लथबन्धो यथा",
    "ref": "पिण्डलक्षणम् -> 10"
  },
  {
    "verse": "विभूदावुन्ने",
    "ref": "पिण्डलक्षणम् -> 11"
  },
  {
    "verse": "दधिक्राविवीण्णः",
    "ref": "पिण्डलक्षणम् -> 12"
  },
  {
    "verse": "ग्रावीण्णः",
    "ref": "पिण्डलक्षणम् -> 13"
  },
  {
    "verse": "पूर्वोक्ते दारुपिण्डे स्पर्शस्य पूर्वत्वं विवक्षितम्",
    "ref": "पिण्डलक्षणम् -> 14"
  },
  {
    "verse": "अत्र तु वकारस्य अन्तस्थायाः पूर्वत्वमिति श्लथबन्धे विशेषः",
    "ref": "पिण्डलक्षणम् -> 15"
  },
  {
    "verse": "अतोऽस्य न दारुपिण्डेऽन्तर्भावः",
    "ref": "पिण्डलक्षणम् -> 16"
  },
  {
    "verse": "बध्नन्ति यथाभारं त्रीणस्य संवेष्ट्यवाहकाः पुरुषाः सयकारवर्णपिण्डं \nसमुच्चरे द्वैदिकन्तद्वत्",
    "ref": "पिण्डलक्षणम् -> 17"
  },
  {
    "verse": "अयन्त्रीणबन्धः",
    "ref": "पिण्डलक्षणम् -> 18"
  },
  {
    "verse": "यथा",
    "ref": "पिण्डलक्षणम् -> 19"
  },
  {
    "verse": "प्रजननं ज्योतिः अभ्यश्नुते अप्वायध्वं यम्यासं विवदाना",
    "ref": "पिण्डलक्षणम् -> 20"
  },
  {
    "verse": "अत्र दारुपिण्ड एव यकाररूपान्तस्थायाः स्पर्शयोगे \nतृणरजुबंधवत्",
    "ref": "पिण्डलक्षणम् -> 21"
  },
  {
    "verse": "उच्चरेदिति विशेषविद्ध्यर्थमयमारंभः",
    "ref": "पिण्डलक्षणम् -> 22"
  },
  {
    "verse": "उत्तमपरो हकारो नासिक्यश्चौरसश्च भवेत्",
    "ref": "पिण्डलक्षणम् -> 23"
  },
  {
    "verse": "ओ औरस एवान्तस्थाया परो नणमपरो महानादः",
    "ref": "पिण्डलक्षणम् -> 24"
  },
  {
    "verse": "अत्र पूर्वार्धेन तुर्यवाक्येन च मूलपिण्डे विशेषमाहस यथा",
    "ref": "पिण्डलक्षणम् -> 25"
  },
  {
    "verse": "शरद्यपराह्णे",
    "ref": "पिण्डलक्षणम् -> 26"
  },
  {
    "verse": "अह्न्नान्दीकेतुः ब्रह्मवादिनः तृतीयपादेन दारुपिण्डविशेष उक्तः",
    "ref": "पिण्डलक्षणम् -> 27"
  },
  {
    "verse": "तुर्यर्चेन च दारुपिण्डमन्तस्थैर्युक्तमिति गौतमोक्तेः",
    "ref": "पिण्डलक्षणम् -> 28"
  },
  {
    "verse": "इहापि दारुपिण्ड एव",
    "ref": "पिण्डलक्षणम् -> 29"
  },
  {
    "verse": "यथा मह्यन्नमन्तां कृशिषन्दुह्रेह्लादयते",
    "ref": "पिण्डलक्षणम् -> 30"
  },
  {
    "verse": "अह्वाधाः",
    "ref": "पिण्डलक्षणम् -> 31"
  },
  {
    "verse": "प अन्तस्थोक्तमयोगेना उत्सृज्योघ्राणजो हकारस्य वायुः परयोदि स्यात् \nतत्र तु पृथगुच्चारयेदेनं हकारस्यान्तस्थोक्तमेभ्यः पूर्वत्वे हकारस्य वायुः \nकण्डदेशे न त्याज्यः",
    "ref": "पिण्डलक्षणम् -> 32"
  },
  {
    "verse": "किं तु उरसैव हकार उच्चारणीय्य इत्यर्थः \nतथा च शिक्षा वचनम्",
    "ref": "पिण्डलक्षणम् -> 33"
  },
  {
    "verse": "हकारं पंचमैर्युक्तमन्तस्थाभिश्च संयुतम् \nउरस्यन्तं विजानीयात्कण्ठ्यमाहुरसंयुतम् । इति",
    "ref": "पिण्डलक्षणम् -> 34"
  },
  {
    "verse": "हकारस्य परत्वेऽनुपूर्वैरन्तस्थोक्तमैहिकारमश्लिष्टमुच्चरेत्",
    "ref": "पिण्डलक्षणम् -> 35"
  },
  {
    "verse": "यथा चतुर्होतृणां मल्यहा प्रत्यन्दीहोतारं एतान् होमान्",
    "ref": "पिण्डलक्षणम् -> 36"
  },
  {
    "verse": "मातृकायामप्यसंपूर्णम्",
    "ref": "पिण्डलक्षणम् -> 37"
  }
